  "info": {
    "contact": {
      "email": "support@crawlora.net",
      "name": "API Support",
      "url": "https://crawlora.net"
    },
    "description": "Crawlora is a hosted web-data and SERP API: call documented REST endpoints and get normalized JSON instead of HTML to parse — across search/SERP, maps and local, e-commerce, app stores, social, media and finance. One API key; Crawlora runs the proxy rotation, headless browsers and parsing behind the scenes. Billed pay-on-success: charged only on a successful 2xx response, 1-10 credits per call, with a free tier of 2,000 credits per month and no card. A hosted MCP server (mcp.crawlora.net/mcp) exposes the same catalog as agent tools. Search endpoints accept `q` as a universal alias for whichever search-term parameter they document (`query`, `term`, `keyword`, or Amazon's `k`), so one parameter name works across the whole catalog; an explicitly supplied documented name always wins.",
    "license": {
      "name": "Crawlora Terms of Service",
      "url": "https://crawlora.net/terms"
    },
    "termsOfService": "https://crawlora.net/terms",
    "title": "Crawlora API",
    "version": "1.2",
    "x-logo": {
      "altText": "Crawlora",
      "backgroundColor": "#FFFFFF",
      "url": "https://raw.githubusercontent.com/Crawlora-org/crawlora-mcp/main/assets/logo-400x400.png"
    }
  },
  "paths": {
    "/wallapop/categories": {
      "get": {
        "consumes": [
          "application/json"
        ],
        "description": "Returns the complete live search taxonomy as a flat parent-linked list, including all descendant IDs used by /wallapop/search. Only IDs from this search taxonomy are accepted; legacy navigation-only IDs are excluded. Re-fetch periodically because the upstream taxonomy changes.",
        "operationId": "wallapop-categories",
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/wallapop.categoriesResponseDoc"
            }
          },
          "429": {
            "description": "Too Many Requests",
            "schema": {
              "$ref": "#/definitions/app.Response"
            }
          },
          "500": {
            "description": "Internal Server Error",
            "schema": {
              "$ref": "#/definitions/app.Response"
            }
          },
          "503": {
            "description": "Service Unavailable",
            "schema": {
              "$ref": "#/definitions/app.Response"
            }
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "summary": "Discover Wallapop search categories",
        "tags": [
          "wallapop"
        ]
      }
    },
    "/wallapop/filter-options": {
      "get": {
        "consumes": [
          "application/json"
        ],
        "description": "Returns one page from a remote option list advertised by /wallapop/filters. Use its exact filter_id and category_id. brand/model lists use a root category ID; category-specific lists use the selected category ID. Model discovery requires brand. Multi-select options such as size map to the live search parameter fashion_size. q and sort provide listing context; options_query narrows the option list. Follow next_cursor while repeating the same context; an empty terminal page has no next_cursor. Option IDs are accepted by /wallapop/search's filter parameter.",
        "operationId": "wallapop-filter-options",
        "parameters": [
          {
            "description": "Remote filter ID advertised by /wallapop/filters for this category",
            "in": "query",
            "name": "filter_id",
            "required": true,
            "type": "string",
            "x-example": "item_language"
          },
          {
            "description": "Live category ID from /wallapop/categories. Use a root for brand/model or the selected category for category-specific remote options.",
            "in": "query",
            "name": "category_id",
            "required": true,
            "type": "integer",
            "x-example": 24100
          },
          {
            "description": "Required with filter_id=model; a brand option ID",
            "in": "query",
            "name": "brand",
            "type": "string",
            "x-example": "BMW"
          },
          {
            "description": "Optional listing search context",
            "in": "query",
            "name": "q",
            "type": "string",
            "x-example": "iphone"
          },
          {
            "description": "Optional listing sort context",
            "enum": [
              "closest",
              "most_relevance",
              "newest",
              "price_low_to_high",
              "price_high_to_low"
            ],
            "in": "query",
            "name": "sort",
            "type": "string",
            "x-example": "most_relevance"
          },
          {
            "description": "Optional text search inside the dynamic option list",
            "in": "query",
            "name": "options_query",
            "type": "string",
            "x-example": "BMW"
          },
          {
            "description": "Opaque next_cursor returned by this endpoint",
            "in": "query",
            "name": "cursor",
            "type": "string"
          }
        ],
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/wallapop.filterOptionsResponseDoc"
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/app.Response"
            }
          },
          "404": {
            "description": "Not Found",
            "schema": {
              "$ref": "#/definitions/app.Response"
            }
          },
          "429": {
            "description": "Too Many Requests",
            "schema": {
              "$ref": "#/definitions/app.Response"
            }
          },
          "500": {
            "description": "Internal Server Error",
            "schema": {
              "$ref": "#/definitions/app.Response"
            }
          },
          "503": {
            "description": "Service Unavailable",
            "schema": {
              "$ref": "#/definitions/app.Response"
            }
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "summary": "Discover Wallapop remote filter values",
        "tags": [
          "wallapop"
        ]
      }
    },
    "/wallapop/filters": {
      "get": {
        "consumes": [
          "application/json"
        ],
        "description": "Returns Wallapop's live search filter schema for a query and optional category. Each filter includes its current type, the upstream search-enabled flag when provided, accepted parameter names, inline option values or slider bounds, and a category-scoped /wallapop/filter-options link for remote value lists.",
        "operationId": "wallapop-filters",
        "parameters": [
          {
            "description": "Optional search phrase used to select relevant filters",
            "in": "query",
            "name": "q",
            "type": "string",
            "x-example": "iphone"
          },
          {
            "description": "Any live search taxonomy ID from /wallapop/categories",
            "in": "query",
            "name": "category_id",
            "type": "integer",
            "x-example": 100
          }
        ],
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/wallapop.filtersResponseDoc"
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/app.Response"
            }
          },
          "404": {
            "description": "Not Found",
            "schema": {
              "$ref": "#/definitions/app.Response"
            }
          },
          "429": {
            "description": "Too Many Requests",
            "schema": {
              "$ref": "#/definitions/app.Response"
            }
          },
          "500": {
            "description": "Internal Server Error",
            "schema": {
              "$ref": "#/definitions/app.Response"
            }
          },
          "503": {
            "description": "Service Unavailable",
            "schema": {
              "$ref": "#/definitions/app.Response"
            }
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "summary": "Discover Wallapop search filters",
        "tags": [
          "wallapop"
        ]
      }
    },
    "/wallapop/item": {
      "get": {
        "consumes": [
          "application/json"
        ],
        "description": "Returns public listing details parsed from the anonymous server-rendered item page: description, price, taxonomy, condition, images, coarse location, shipping, category attributes, hashtags, and related-search links. Pass a clean https item URL returned by /wallapop/search, using es.wallapop.com, it.wallapop.com, or pt.wallapop.com. Seller/profile/contact data, exact coordinates, postal codes, favorites, and view-tracking state are omitted. The upstream may rate-limit or block requests; this endpoint uses the measured browser_android_native@fresh profile and retries up to three times.",
        "operationId": "wallapop-item-detail",
        "parameters": [
          {
            "description": "Clean https public item URL from /wallapop/search on es.wallapop.com, it.wallapop.com, or pt.wallapop.com",
            "in": "query",
            "name": "url",
            "required": true,
            "type": "string",
            "x-example": "https%3A%2F%2Fes.wallapop.com%2Fitem%2Fchaqueta-1183989904"
          }
        ],
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/wallapop.itemDetailResponseDoc"
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/app.Response"
            }
          },
          "404": {
            "description": "Not Found",
            "schema": {
              "$ref": "#/definitions/app.Response"
            }
          },
          "429": {
            "description": "Too Many Requests",
            "schema": {
              "$ref": "#/definitions/app.Response"
            }
          },
          "500": {
            "description": "Internal Server Error",
            "schema": {
              "$ref": "#/definitions/app.Response"
            }
          },
          "503": {
            "description": "Service Unavailable",
            "schema": {
              "$ref": "#/definitions/app.Response"
            }
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "summary": "Fetch a public Wallapop listing detail page",
        "tags": [
          "wallapop"
        ]
      }
    },
    "/wallapop/search": {
      "get": {
        "consumes": [
          "application/json"
        ],
        "description": "Returns one page of public Wallapop listing cards with title, price, currency, images, coarse location, taxonomy, shipping state, and a public item URL. q is a free-text search. latitude and longitude are required caller-provided coordinates because Wallapop otherwise resolves location from the request egress. category_id accepts any ID returned by /wallapop/categories, including descendants. sort is one of closest, most_relevance, newest, price_low_to_high, or price_high_to_low. When category_id is supplied, discover condition values from /wallapop/filters; categories can add values beyond the base set. Use /wallapop/filter-options for remote filter values. Pass next_cursor back as cursor by itself to fetch the next page.",
        "operationId": "wallapop-search",
        "parameters": [
          {
            "description": "Free-text listing search, 2 to 200 characters",
            "in": "query",
            "name": "q",
            "required": true,
            "type": "string",
            "x-example": "iphone"
          },
          {
