{
  "name": "@crawlora-org/wallapop",
  "version": "0.1.0",
  "description": "Crawlora Wallapop API client with 5 endpoints for public listing search, categories, filters, and item details",
  "homepage": "https://crawlora.net/?utm_source=npm&utm_medium=referral&utm_campaign=platform-clients&utm_content=wallapop-javascript-homepage",
  "bugs": { "url": "https://github.com/Crawlora-org/crawlora-wallapop/issues" },
  "keywords": ["crawlora", "api-client", "sdk", "web-scraping", "scraping-api", "wallapop", "wallapop-api", "wallapop-scraper", "wallapop-data", "wallapop-public-listing-search", "wallapop-categories", "wallapop-filters", "wallapop-item-details"],
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "files": ["src", "README.md", "LICENSE"],
  "engines": { "node": ">=18" },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Crawlora-org/crawlora-wallapop",
    "directory": "javascript"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "typecheck": "tsc --noEmit",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "generate": "python3 ../scripts/generate.py"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  }
}
