{
  "name": "crawlora/wallapop",
  "description": "Crawlora Wallapop API client with 5 endpoints for public listing search, categories, filters, and item details",
  "keywords": [
    "crawlora",
    "api-client",
    "sdk",
    "web-scraping",
    "scraping-api",
    "wallapop",
    "wallapop-api",
    "wallapop-scraper",
    "wallapop-data",
    "wallapop-public-listing-search",
    "wallapop-categories",
    "wallapop-filters",
    "wallapop-item-details"
  ],
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.1",
    "ext-curl": "*",
    "ext-json": "*"
  },
  "autoload": {
    "psr-4": {
      "Crawlora\\Wallapop\\": "src/Crawlora/Wallapop/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Crawlora\\Wallapop\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "php tests/client_test.php"
  },
  "homepage": "https://crawlora.net/?utm_source=packagist&utm_medium=referral&utm_campaign=platform-clients&utm_content=wallapop-php-homepage",
  "support": {
    "source": "https://github.com/Crawlora-org/crawlora-wallapop",
    "docs": "https://crawlora.net/docs?utm_source=packagist&utm_medium=referral&utm_campaign=platform-clients&utm_content=wallapop-php-api-docs"
  }
}
