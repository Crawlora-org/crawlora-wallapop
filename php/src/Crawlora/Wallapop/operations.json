        {
          "name": "cursor",
          "in": "query",
          "type": "string"
        }
      ],
      "bodyParam": null,
      "bodyRequired": false,
      "params": [
        {
          "description": "Free-text listing search, 2 to 200 characters",
          "in": "query",
          "name": "q",
          "required": true,
          "type": "string",
          "x-example": "iphone"
        },
        {
          "description": "Caller-provided search latitude, -90 through 90",
          "in": "query",
          "name": "latitude",
          "required": true,
          "type": "number",
          "x-example": 40.4168
        },
        {
          "description": "Caller-provided search longitude, -180 through 180",
          "in": "query",
          "name": "longitude",
          "required": true,
          "type": "number",
          "x-example": -3.7038
        },
        {
          "description": "Any live search taxonomy ID from /wallapop/categories",
          "in": "query",
          "name": "category_id",
          "type": "integer",
          "x-example": 24200
        },
        {
          "description": "Wallapop sort order",
          "enum": [
            "closest",
            "most_relevance",
            "newest",
            "price_low_to_high",
            "price_high_to_low"
          ],
          "in": "query",
          "name": "sort",
          "type": "string",
          "x-example": "most_relevance"
        },
        {
          "description": "Minimum sale price",
          "in": "query",
          "name": "min_price",
          "type": "number",
          "x-example": 10
        },
        {
          "description": "Maximum sale price",
          "in": "query",
          "name": "max_price",
          "type": "number",
          "x-example": 500
        },
        {
          "description": "Repeatable or comma-separated condition values. With category_id, use the current values from /wallapop/filters; without category_id, base values are new, as_good_as_new, good, fair, and has_given_it_all.",
          "in": "query",
          "name": "condition",
          "type": "string",
          "x-example": "new,good"
        },
        {
          "description": "Pass true to limit to shipping-capable listings; omit to include all. false is rejected because Wallapop ignores it.",
          "enum": [
            "true"
          ],
          "in": "query",
          "name": "is_shippable",
          "type": "string",
          "x-example": "true"
        },
        {
          "description": "Listing date window",
          "enum": [
            "today",
            "lastWeek",
            "lastMonth"
          ],
          "in": "query",
          "name": "time_filter",
          "type": "string",
          "x-example": "lastWeek"
        },
        {
          "description": "Maximum distance from the supplied coordinates, 0 through 1000 km",
          "in": "query",
          "name": "distance_in_km",
          "type": "integer",
          "x-example": 25
        },
        {
          "collectionFormat": "csv",
          "description": "Repeatable category-specific key:value pair discovered from /wallapop/filters, e.g. brand:BMW, color:Black, has_warranty:true, storage_capacity:128gb, item_language:english, or fashion_size:3,4. For remote values use IDs returned by /wallapop/filter-options.",
          "in": "query",
          "items": {
            "type": "string"
          },
          "name": "filter",
          "type": "array",
          "x-example": "storage_capacity:128gb"
        },
        {
          "description": "Opaque next_cursor returned by a previous response. Use it alone, without initial search parameters.",
          "in": "query",
          "name": "cursor",
          "type": "string",
          "x-example": "eyJ2IjoxLCJuZXh0X3BhZ2UiOiJ..."
        }
      ],
      "produces": [
        "application/json"
      ],
      "security": [
        "ApiKeyAuth"
      ]
    }
