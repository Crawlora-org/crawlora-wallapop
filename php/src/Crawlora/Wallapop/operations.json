          "name": "filter_id",
          "required": true,
          "type": "string",
          "x-example": "item_language"
        },
        {
          "description": "Live category ID from /wallapop/categories. Use a root for brand/model or the selected category for category-specific remote options.",
          "in": "query",
          "name": "category_id",
          "required": true,
          "type": "integer",
          "x-example": 24100
        },
        {
          "description": "Required with filter_id=model; a brand option ID",
          "in": "query",
          "name": "brand",
          "type": "string",
          "x-example": "BMW"
        },
        {
          "description": "Optional listing search context",
          "in": "query",
          "name": "q",
          "type": "string",
          "x-example": "iphone"
        },
        {
          "description": "Optional listing sort context",
          "enum": [
            "closest",
            "most_relevance",
            "newest",
            "price_low_to_high",
            "price_high_to_low"
          ],
          "in": "query",
          "name": "sort",
          "type": "string",
          "x-example": "most_relevance"
        },
        {
          "description": "Optional text search inside the dynamic option list",
          "in": "query",
          "name": "options_query",
          "type": "string",
          "x-example": "BMW"
        },
        {
          "description": "Opaque next_cursor returned by this endpoint",
          "in": "query",
          "name": "cursor",
          "type": "string"
        }
      ],
      "produces": [
        "application/json"
      ],
      "security": [
        "ApiKeyAuth"
